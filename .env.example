# Copy this file to .env in the project root and replace all placeholders.
# Never commit .env. Generate secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"

# Django
DJANGO_SECRET_KEY=replace-with-a-generated-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Tehran

# Keep JWT signing independent from DJANGO_SECRET_KEY in real deployments.
JWT_SIGNING_KEY=replace-with-a-second-generated-random-secret

# Database: sqlite (default) or postgresql
DB_ENGINE=sqlite
# DB_ENGINE=postgresql
# DB_NAME=aegisvision
# DB_USER=postgres
# DB_PASSWORD=replace-with-database-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# Frontend / CORS / CSRF
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=True

# Email: console backend is suitable for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=AEGISVISION Security <security@aegisvision.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# For SMTP, use django.core.mail.backends.smtp.EmailBackend and fill the
# EMAIL_* settings above. Do not commit SMTP credentials.

# Optional production HTTPS settings (review with your reverse-proxy setup).
# Set DJANGO_DEBUG=False and configure all production values before deploy.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
